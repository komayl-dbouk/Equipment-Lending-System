                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Optional filter; unmatched valid IDs produce an empty array."
          },
          {
            "name": "equipmentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Optional filter; unmatched valid IDs produce an empty array."
          }
        ]
      }
    },
    "/api/loans/{id}/return": {
      "post": {
        "operationId": "returnEquipment",
        "tags": [
          "Loans"
        ],
        "summary": "Record return once and preserve history",
        "description": "returnDate must be on/after borrowingDate; an earlier date returns 400 INVALID_RETURN_DATE and malformed input returns 400 VALIDATION_FAILED. A second return returns 409 LOAN_ALREADY_RETURNED without overwriting the first date. Success is returned only after commit.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED: malformed or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "LOAN_NOT_FOUND: loan does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "LOAN_ALREADY_RETURNED: first return date is preserved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Positive record identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnWrite"
              }
            }
          }
        }
      }
    },
    "/api/loans/overdue": {
      "get": {
        "operationId": "listOverdueLoans",
        "tags": [
          "Loans"
        ],
        "summary": "List active loans strictly past due",
        "description": "returnDate is null and dueDate < today in Asia/Beirut. Due today and returned loans are excluded. Results ordered by ID.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Loan"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "staffBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "Required for every /api/** operation. Username and password come from the private process environment. Basic credentials require HTTPS outside the loopback-only local demonstration boundary."
      }
    },
    "schemas": {
      "StudentWrite": {
        "type": "object",
        "description": "POST and PUT require both editable fields. Raw lengths include padding; validate email syntax after normalization. Generated IDs are never writable.",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$",
            "description": "Trim whitespace; must remain nonblank."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$",
            "description": "Trim and lowercase with Locale.ROOT, then validate email syntax; normalized value must be unique."
          }
        },
        "example": {
          "name": "Test Student One",
          "email": " Borrower.One@Example.test "
        }
      },
      "Student": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "example": {
          "id": 1,
          "name": "Test Student One",
          "email": "borrower.one@example.test"
        }
      },
      "EquipmentWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventoryCode",
          "name",
          "category"
        ],
        "properties": {
          "inventoryCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$",
            "description": "Trim and uppercase with Locale.ROOT; normalized value must be unique."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$",
            "description": "Trim whitespace; must remain nonblank."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$",
            "description": "Free text; trim and require nonblank."
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Optional; omitted becomes null on create or replacement update.",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "example": {
          "inventoryCode": "cam-001",
          "name": "Demo Camera",
          "category": "Camera",
          "description": null
        }
      },
      "Equipment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inventoryCode",
          "name",
          "category",
          "description",
          "available"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "inventoryCode": {
            "type": "string",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "available": {
            "type": "boolean",
            "description": "Derived from absence of active loan; read only."
          }
        },
        "example": {
          "id": 1,
          "inventoryCode": "CAM-001",
          "name": "Demo Camera",
          "category": "Camera",
          "description": null,
          "available": true
        }
      },
      "LoanWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "equipmentId",
          "borrowingDate",
          "dueDate"
        ],
        "properties": {
          "studentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "equipmentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "borrowingDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Must be strictly later than borrowingDate.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "ReturnWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returnDate"
        ],
        "properties": {
          "returnDate": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD with exactly four unsigned year digits and a valid calendar day. Must be on or after the loan borrowingDate; no future-date restriction.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "Loan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "studentId",
          "equipmentId",
          "borrowingDate",
          "dueDate",
          "returnDate"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "studentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "equipmentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "borrowingDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "status",
          "code",
          "message",
          "path",
          "fieldErrors"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid staff credential; no business processing",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Basic realm=\"equipment-lending\""
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
