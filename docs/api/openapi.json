    "/api/loans": {
      "post": {
        "operationId": "borrowEquipment",
        "tags": [
          "Loans"
        ],
        "summary": "Record one atomic equipment loan",
        "description": "dueDate must be later than borrowingDate; equal/reversed dates return 400 INVALID_LOAN_DATES, while malformed input returns 400 VALIDATION_FAILED. Existing student and equipment are required. An active loan or confirmed concurrent uniqueness conflict returns 409 EQUIPMENT_UNAVAILABLE. There is no idempotency key or automatic POST retry. Success is returned only after commit.",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED: malformed or invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "STUDENT_NOT_FOUND or EQUIPMENT_NOT_FOUND: required reference does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "EQUIPMENT_UNAVAILABLE: equipment has an active loan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanWrite"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listLoans",
        "tags": [
          "Loans"
        ],
        "summary": "List loan history ordered by ID",
        "description": "Optional studentId and equipmentId combine with AND. Positive but unmatched IDs yield []; no pagination.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
