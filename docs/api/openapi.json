            "minimum": 1
          },
          "equipmentId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "borrowingDate": {
            "type": "string",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
