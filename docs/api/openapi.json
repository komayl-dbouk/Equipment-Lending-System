          "Students"
        ],
        "summary": "Register a borrower",
        "description": "Register a borrower",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                },
                "example": {
                  "id": 1,
                  "name": "Test Student One",
                  "email": "borrower.one@example.test"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI of the created student",
                "schema": {
                  "type": "string"
                },
                "example": "/api/students/1"
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Staff authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Basic realm=\"equipment-lending\""
              }
            }
          },
          "409": {
            "description": "Email is already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
