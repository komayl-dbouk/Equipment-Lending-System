    "/api/loans": {
      "post": {
        "operationId": "borrowEquipment",
        "tags": [
          "Loans"
        ],
        "summary": "Record one atomic equipment loan",
        "description": "dueDate > borrowingDate. Existing student and equipment required. Active loan or confirmed concurrent uniqueness conflict returns 409. No automatic POST retry/idempotency key. Success is returned after transaction commit.",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Loan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
