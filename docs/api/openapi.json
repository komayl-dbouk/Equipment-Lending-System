  "components": {
    "securitySchemes": {
      "staffBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "One staff credential supplied by environment; no committed passwords. Remote use requires HTTPS."
      }
    },
    "schemas": {
      "StudentWrite": {
        "type": "object",
        "description": "POST and PUT require both editable fields. Raw lengths include padding; validate email syntax after normalization. Generated IDs are never writable.",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S",
            "description": "Trim whitespace; must remain nonblank."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254,
            "pattern": "\\S",
            "description": "Trim and lowercase with Locale.ROOT, then validate email syntax; normalized value must be unique."
          }
        },
        "example": {
          "name": "Test Student One",
          "email": " Borrower.One@Example.test "
        }
      },
      "Student": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "example": {
          "id": 1,
          "name": "Test Student One",
          "email": "borrower.one@example.test"
        }
      },
      "EquipmentWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventoryCode",
          "name",
          "category"
        ],
        "properties": {
          "inventoryCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "\\S",
            "description": "Trim and uppercase with Locale.ROOT; normalized value must be unique."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S",
            "description": "Trim whitespace; must remain nonblank."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S",
            "description": "Free text; trim and require nonblank."
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Optional; omitted becomes null on create or replacement update."
          }
        },
        "example": {
          "inventoryCode": "cam-001",
          "name": "Demo Camera",
          "category": "Camera",
          "description": null
        }
      },
      "Equipment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inventoryCode",
          "name",
          "category",
          "description",
          "available"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "inventoryCode": {
            "type": "string",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "available": {
            "type": "boolean",
            "description": "Derived from absence of active loan; read only."
          }
        },
        "example": {
          "id": 1,
          "inventoryCode": "CAM-001",
          "name": "Demo Camera",
          "category": "Camera",
          "description": null,
          "available": true
        }
      },
      "LoanWrite": {
        "type": "object",
