                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentWrite"
              },
              "example": {
                "name": "Test Student One",
                "email": " Borrower.One@Example.test "
              }
            }
          }
        }
