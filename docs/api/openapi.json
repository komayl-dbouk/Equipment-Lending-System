{
  "openapi": "3.0.3",
  "info": {
    "title": "University Equipment Lending API",
    "version": "1.0.0-planned",
    "description": "Planned implementation baseline. Examples are synthetic expected behavior, not captured traffic. Raw request string maxima apply before trimming; normalized values must remain valid. Dates are ISO LocalDate; overdue uses a Clock in Asia/Beirut. Unknown write properties are rejected. Authentication is required for delivery; implementation is pending."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local demonstration only; use HTTPS for remote access."
    }
  ],
  "security": [
    {
      "staffBasic": []
    }
  ],
  "tags": [
    {
      "name": "Students"
    },
    {
      "name": "Equipment"
    },
    {
      "name": "Loans"
    }
  ],
