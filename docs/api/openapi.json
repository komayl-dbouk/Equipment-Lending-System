{
  "openapi": "3.0.3",
  "info": {
    "title": "University Equipment Lending API",
    "version": "1.0.0",
    "description": "Implemented API through ELS-46. Examples in this file are illustrative; docs/api/examples.ps1 is executable and captures generated IDs. Raw request string maxima apply before trimming; normalized values must remain valid. Loan dates are strict four-digit ISO calendar dates; overdue uses the injected Asia/Beirut clock. Unknown write properties are rejected. Every documented API operation requires the environment-configured staff Basic credential. Loopback HTTP is for local demonstration only; remote credential transport requires HTTPS outside this application."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local demonstration only; use HTTPS for remote access."
    }
  ],
  "x-delivery-security": {
    "status": "implemented-local-boundary",
    "jira": "ELS-46",
    "description": "The runtime requires one environment-configured staff Basic credential for /api/** and emits a sanitized 401 for missing or invalid credentials. /actuator/health is the only deliberately public route and is not part of this OpenAPI path inventory. The application does not terminate or verify remote HTTPS."
  },
  "security": [
    {
      "staffBasic": []
    }
  ],
  "tags": [
    {
      "name": "Students",
      "description": "Register, retrieve and replace student borrower records."
    },
    {
      "name": "Equipment",
      "description": "Create, list, filter, replace and conditionally delete physical equipment."
    },
    {
      "name": "Loans",
      "description": "Borrow, return and query immutable loan history."
    }
  ],
  "paths": {
    "/api/students": {
      "post": {
        "operationId": "registerStudent",
        "tags": [
          "Students"
        ],
        "summary": "Register a borrower",
        "description": "Register a borrower",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                },
                "example": {
                  "id": 1,
                  "name": "Test Student One",
                  "email": "borrower.one@example.test"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI of the created student",
                "schema": {
                  "type": "string"
                },
                "example": "/api/students/1"
              }
            }
          },
          "400": {
            "description": "Invalid request: VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_EMAIL: normalized email is already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentWrite"
              },
              "example": {
                "name": "Test Student One",
                "email": " Borrower.One@Example.test "
              }
            }
          }
        }
      }
    },
