              "pm.test(\"Duplicate code\", () => pm.expect(value.code).to.eql(\"DUPLICATE_INVENTORY_CODE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sorted equipment list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/equipment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const value = pm.response.json();",
              "pm.test(\"Sorted array\", () => { const ids=value.map(v=>v.id); pm.expect(ids).to.eql([...ids].sort((a,b)=>a-b)); });"
            ]
          }
        }
      ]
    },
