            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const value = pm.response.json();",
              "pm.test(\"Omitted description becomes null\", () => pm.expect(value.description).to.eql(null));"
            ]
          }
        }
      ]
    },
